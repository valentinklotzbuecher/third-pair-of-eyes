# API keys and secrets
.Renviron
.env
*.key
credentials.json
key/

# Review jobs hold the documents under review (and possibly cleared data):
# they never go into git. Only the README that explains the folder is tracked.
jobs/*
!jobs/README.md

# Patient-level data, wherever it lands
*.sas7bdat
*.sav
*.dta
*.xpt
*.parquet

# R artifacts
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/
.Rproj.user/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Quarto render artifacts
*_files/
*_cache/
.quarto/

# Archived prototype: local inputs and run records
archive/2026_api_prototype/review_examples/*.pdf
archive/2026_api_prototype/review_examples/dat/
archive/2026_api_prototype/review_results/prototype_jobs/
archive/2026_api_prototype/review_results/prototype_runs/
archive/2026_api_prototype/review_prototype.html
archive/2026_api_prototype/review_prototype.pdf

# OS and editor files
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
*.aux
*.toc
